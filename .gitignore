# Playwright
apps/visual/test-results/
apps/visual/playwright-report/
apps/visual/blob-report/
# CI baselines are Linux-only; local Windows/macOS screenshots are never committed
apps/visual/tests/**/*-win32.png
apps/visual/tests/**/*-darwin.png
packages/*/LICENSE
packages/*/NOTICE
apps/docs/public/icons/

# m3e-elements: declarations emitted by tsc before tsup bundles them
packages/*/.dts/

# apps/site: generated at build time (icon subset, API data) and test output
apps/site/src/generated/
apps/site/test-results/
apps/site/playwright-report/
apps/site/lighthouse/
