---
// Static navigation items in the m3e-css contract (navigation-item.css), for the docs pages.
export interface Item {
  icon: string;
  label: string;
  selected?: boolean;
  disabled?: boolean;
  iconOnly?: boolean;
  /** A badge on the icon (badge.css): `''` the dot, else its text ("8", "999+"). */
  badge?: string;
  /** The badge's hidden text (default: "New notification" for the dot, else the text). */
  badgeLabel?: string;
}

interface Props {
  items: readonly Item[];
  prefix: string;
}

const { items, prefix } = Astro.props;
const badgeName = (item: Item) => item.badgeLabel ?? (item.badge ? item.badge : 'New notification');
---

{
  items.map((item) => (
    <a
      class="m3e-navigation-item"
      href={item.disabled ? undefined : `#${prefix}-${item.icon}`}
      aria-current={item.selected ? 'page' : undefined}
      aria-disabled={item.disabled ? 'true' : undefined}
      aria-label={
        item.iconOnly
          ? item.badge === undefined
            ? item.label
            : `${item.label} ${badgeName(item)}`
          : undefined
      }
      data-testid={`${prefix}-${item.icon}`}
    >
      <span class="m3e-navigation-item__content">
        <span class="m3e-navigation-item__indicator" aria-hidden="true" />
        <span class="m3e-navigation-item__state" aria-hidden="true" />
        {item.badge === undefined ? (
          <span class="m3e-icon m3e-navigation-item__icon" aria-hidden="true">
            {item.icon}
          </span>
        ) : null}
        {item.iconOnly ? null : <span class="m3e-navigation-item__label">{item.label}</span>}
        {item.badge === undefined ? null : (
          <span class="m3e-badged-box">
            <span class="m3e-icon m3e-navigation-item__icon" aria-hidden="true">
              {item.icon}
            </span>
            <span class={item.badge ? 'm3e-badge m3e-badge--large' : 'm3e-badge'}>
              {item.badge ? (
                <span class="m3e-badge__text" aria-hidden="true">
                  {item.badge}
                </span>
              ) : null}
              {item.iconOnly ? null : <span class="m3e-badge__label">{badgeName(item)}</span>}
            </span>
          </span>
        )}
      </span>
    </a>
  ))
}
