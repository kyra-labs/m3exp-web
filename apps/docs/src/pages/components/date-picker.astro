---
import Base from '../../layouts/Base.astro';
---

<Base title="Date pickers">
  <link rel="stylesheet" href="/icons/docs-icons.css" slot="head" />
  <h1>Date pickers</h1>
  <section aria-labelledby="modal-heading">
    <h2 id="modal-heading">Date picker (element)</h2>
    <div class="docs-time-picker-row">
      <figure>
        <figcaption>Calendar</figcaption>
        <m3e-date-picker data-testid="picker" value="2025-08-17" displayed-month="2025-08"></m3e-date-picker>
      </figure>
      <figure>
        <figcaption>Input</figcaption>
        <m3e-date-picker data-testid="input" value="2025-08-17" display-mode="input"></m3e-date-picker>
      </figure>
    </div>
  </section>
  <section aria-labelledby="range-heading">
    <h2 id="range-heading">Range (element)</h2>
    <div style="block-size: 560px; inline-size: 360px; display: flex; flex-direction: column;">
      <m3e-date-range-picker data-testid="range" start="2025-08-10" end="2025-08-20" displayed-month="2025-08" style="display: contents"></m3e-date-range-picker>
    </div>
  </section>
  <section aria-labelledby="docked-heading">
    <h2 id="docked-heading">Docked (element)</h2>
    <m3e-docked-date-picker data-testid="docked" value="2025-08-17"></m3e-docked-date-picker>
    <div style="block-size: 480px"></div>
  </section>
</Base>

<script>
  import '@kyralabs/m3exp-web/elements';
</script>
