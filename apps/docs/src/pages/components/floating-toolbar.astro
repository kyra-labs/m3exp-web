---
import FloatingToolbarPlayground from '../../islands/FloatingToolbarPlayground.tsx';
import Base from '../../layouts/Base.astro';

const items = [
  { icon: 'format_bold', label: 'Bold' },
  { icon: 'format_italic', label: 'Italic' },
  { icon: 'format_underlined', label: 'Underline' },
];
const leading = [{ icon: 'check', label: 'Done' }];
const trailing = [{ icon: 'favorite', label: 'Favorite' }];
const fabItems = [
  { icon: 'search', label: 'Search' },
  { icon: 'edit', label: 'Edit' },
  { icon: 'share', label: 'Share' },
];

/** Static (CSS-only) toolbars: orientation × expanded × FAB. */
const statics = [
  { id: 'horizontal', vertical: false, expanded: true, fab: false, vibrant: false },
  { id: 'horizontal-collapsed', vertical: false, expanded: false, fab: false, vibrant: false },
  { id: 'vertical', vertical: true, expanded: true, fab: false, vibrant: true },
  { id: 'vertical-collapsed', vertical: true, expanded: false, fab: false, vibrant: true },
  { id: 'fab', vertical: false, expanded: true, fab: true, vibrant: true },
  { id: 'fab-collapsed', vertical: false, expanded: false, fab: true, vibrant: true },
  { id: 'vertical-fab', vertical: true, expanded: true, fab: true, vibrant: false },
  { id: 'vertical-fab-collapsed', vertical: true, expanded: false, fab: true, vibrant: false },
] as const;

const classes = (s: (typeof statics)[number]) =>
  [
    'm3e-floating-toolbar',
    s.vertical && 'm3e-floating-toolbar--vertical',
    s.vibrant && 'm3e-floating-toolbar--vibrant',
    !s.expanded && 'm3e-floating-toolbar--collapsed',
    s.fab && 'm3e-floating-toolbar--with-fab',
  ]
    .filter(Boolean)
    .join(' ');
---

<Base title="Floating toolbar">
  <link rel="stylesheet" href="/icons/docs-icons.css" slot="head" />
  <h1>Floating toolbar</h1>
  <p>
    A pill of actions that floats over the content (COMPONENT_SPEC §9; Compose{' '}
    <code>HorizontalFloatingToolbar</code> / <code>VerticalFloatingToolbar</code>), 64dp across with
    8dp padding and items in 48dp slots, edge to edge. Leading and trailing items show only while it is
    expanded. Beside a FAB the whole toolbar folds into the FAB when collapsed, and the FAB grows from
    56dp to 80dp. Standard (surface container) and vibrant (primary container) color styles; the
    toolbar FAB takes primary container or tertiary container to match.
  </p>

  <section aria-labelledby="css-heading">
    <h2 id="css-heading">CSS only</h2>
    <p>
      Plain HTML with m3e-css classes in their static states. Without JavaScript the with-FAB toolbar
      folds on the fast spatial curve and leading/trailing items show or hide at once; set{' '}
      <code>inert</code> on hidden parts yourself. The springs, roving focus and scroll behaviors come
      from <code>&lt;m3e-floating-toolbar&gt;</code> or React.
    </p>
    <div class="docs-floating-toolbar-grid" data-testid="statics">
      {
        statics.map((s) => (
          <div class="docs-floating-toolbar-frame">
            <div
              class={classes(s)}
              role="toolbar"
              aria-orientation={s.vertical ? 'vertical' : 'horizontal'}
              aria-label={`Static ${s.id}`}
              data-testid={`static-${s.id}`}
            >
              <div class="m3e-floating-toolbar__bar" inert={s.fab && !s.expanded}>
                {!s.fab && (
                  <div class="m3e-floating-toolbar__leading" inert={!s.expanded}>
                    {leading.map((item) => (
                      <button type="button" class="m3e-icon-button" aria-label={item.label} tabindex="-1">
                        <span class="m3e-icon" aria-hidden="true">
                          {item.icon}
                        </span>
                      </button>
                    ))}
                  </div>
                )}
                {(s.fab ? fabItems : items).map((item, i) => (
                  <button
                    type="button"
                    class="m3e-icon-button"
                    aria-label={item.label}
                    tabindex={i === 0 && !(s.fab && !s.expanded) ? '0' : '-1'}
                  >
                    <span class="m3e-icon" aria-hidden="true">
                      {item.icon}
                    </span>
                  </button>
                ))}
                {!s.fab && (
                  <div class="m3e-floating-toolbar__trailing" inert={!s.expanded}>
                    {trailing.map((item) => (
                      <button type="button" class="m3e-icon-button" aria-label={item.label} tabindex="-1">
                        <span class="m3e-icon" aria-hidden="true">
                          {item.icon}
                        </span>
                      </button>
                    ))}
                  </div>
                )}
              </div>
              {s.fab && (
                <div class="m3e-floating-toolbar__fab">
                  <button
                    type="button"
                    class="m3e-fab"
                    aria-label={s.expanded ? 'Collapse toolbar' : 'Expand toolbar'}
                    tabindex={s.expanded ? '-1' : '0'}
                  >
                    <span class="m3e-icon" aria-hidden="true">
                      {s.expanded ? 'close' : 'add'}
                    </span>
                  </button>
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="element-heading">
    <h2 id="element-heading">Element</h2>
    <p>
      <code>&lt;m3e-floating-toolbar&gt;</code> moves its children into the contract:{' '}
      <code>slot="leading"</code> / <code>slot="trailing"</code> items show while{' '}
      <code>expanded</code>, <code>slot="fab"</code> makes the with-FAB toolbar. One tab stop; the
      arrow keys along the toolbar, Home and End move between items. The buttons below toggle{' '}
      <code>expanded</code>; press twice quickly and the springs reverse from their current speed.
    </p>
    <div class="docs-floating-toolbar-row">
      <m3e-floating-toolbar expanded label="Text formatting" data-testid="element-toolbar">
        <button type="button" class="m3e-icon-button" slot="leading" aria-label="Done">
          <span class="m3e-icon" aria-hidden="true">check</span>
        </button>
        {
          items.map((item) => (
            <button type="button" class="m3e-icon-button" aria-label={item.label}>
              <span class="m3e-icon" aria-hidden="true">
                {item.icon}
              </span>
            </button>
          ))
        }
        <button type="button" class="m3e-icon-button" slot="trailing" aria-label="Favorite">
          <span class="m3e-icon" aria-hidden="true">favorite</span>
        </button>
      </m3e-floating-toolbar>
      <button type="button" class="m3e-button m3e-button--outlined" id="element-toggle">
        Collapse
      </button>
    </div>
    <div class="docs-floating-toolbar-row">
      <m3e-floating-toolbar
        expanded
        color-style="vibrant"
        label="Actions"
        data-testid="element-fab-toolbar"
      >
        {
          fabItems.map((item) => (
            <button type="button" class="m3e-icon-button" aria-label={item.label}>
              <span class="m3e-icon" aria-hidden="true">
                {item.icon}
              </span>
            </button>
          ))
        }
        <button type="button" class="m3e-fab" slot="fab" aria-label="Collapse toolbar" id="element-fab">
          <span class="m3e-icon" aria-hidden="true">close</span>
        </button>
      </m3e-floating-toolbar>
    </div>
  </section>

  <section aria-labelledby="react-heading">
    <h2 id="react-heading">React</h2>
    <p>
      <code>&lt;FloatingToolbar&gt;</code> with a FAB that toggles <code>isExpanded</code>, a vertical
      toolbar, and the two scroll behaviors over a scrolling region: <code>exit-always</code> hides the
      toolbar on scroll down and brings it back on scroll up (a partly hidden toolbar snaps when
      scrolling stops); <code>collapse</code> collapses it after 40dp down and expands it after 40dp up.
      Deprecated since 1.8 (removed in 2.0; each warns once in development): <code>expanded</code>
      (use <code>isExpanded</code>) and <code>scrollBehavior="exitAlways"</code> (use
      <code>"exit-always"</code>).
    </p>
    <FloatingToolbarPlayground client:only="react" />
  </section>

  <section aria-labelledby="sources-heading">
    <h2 id="sources-heading">Sources</h2>
    <p>
      androidx Compose Material3 1.5.0-beta01 (<code>19991f2c</code>): <code>FloatingToolbar.kt</code>
      (vendored; layouts, <code>FloatingToolbarDefaults</code>, <code>exitAlwaysScrollBehavior</code>,{' '}
      <code>floatingToolbarVerticalNestedScroll</code>), <code>FloatingToolbarTokens.kt</code> and the
      values Compose renders in <code>components/floating-toolbar-defaults.css</code>;{' '}
      <code>FloatingToolbarSamples.kt</code> for the screen offset and the FAB toggling{' '}
      <code>expanded</code>.
    </p>
  </section>
</Base>

<script>
  import '@kyralabs/m3exp-web/elements';

  const toolbar = document.querySelector<HTMLElement & { expanded: boolean }>(
    '[data-testid="element-toolbar"]',
  )!;
  const toggle = document.querySelector<HTMLButtonElement>('#element-toggle')!;
  toggle.addEventListener('click', () => {
    toolbar.expanded = !toolbar.expanded;
    toggle.textContent = toolbar.expanded ? 'Collapse' : 'Expand';
  });

  const fabToolbar = document.querySelector<HTMLElement & { expanded: boolean }>(
    '[data-testid="element-fab-toolbar"]',
  )!;
  const fab = document.querySelector<HTMLButtonElement>('#element-fab')!;
  fab.addEventListener('click', () => {
    fabToolbar.expanded = !fabToolbar.expanded;
    fab.setAttribute('aria-label', fabToolbar.expanded ? 'Collapse toolbar' : 'Expand toolbar');
    fab.querySelector('.m3e-icon')!.textContent = fabToolbar.expanded ? 'close' : 'add';
  });
</script>
