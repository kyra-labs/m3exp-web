---
import DeprecationBanner from '../../components/DeprecationBanner.astro';
import NavItems, { type Item } from '../../components/NavItems.astro';
import NavigationPlayground from '../../islands/NavigationPlayground.tsx';
import Base from '../../layouts/Base.astro';

const items: Item[] = [
  { icon: 'home', label: 'Home', selected: true },
  { icon: 'search', label: 'Search' },
  { icon: 'favorite', label: 'Favorites' },
  { icon: 'settings', label: 'Settings' },
];
const withDisabled: Item[] = [
  { icon: 'home', label: 'Home' },
  { icon: 'search', label: 'Search', selected: true },
  { icon: 'star', label: 'Starred', disabled: true },
];
const iconOnly: Item[] = items.map((item) => ({ ...item, iconOnly: true }));
// Badges (badge.css on the icon): none, a count, the dot, 999+.
const badged: Item[] = [
  { icon: 'home', label: 'Home', selected: true },
  { icon: 'inbox', label: 'Inbox', badge: '8' },
  { icon: 'chat', label: 'Chat', badge: '' },
  { icon: 'mail', label: 'Mail', badge: '999+', badgeLabel: '1200 unread' },
];
---

<Base title="Navigation bar">
  <link rel="stylesheet" href="/icons/docs-icons.css" slot="head" />
  <h1>Navigation bar</h1>
  <p>
    The short navigation bar (COMPONENT_SPEC §13; Compose <code>ShortNavigationBar</code>). Plain
    HTML with m3e-css classes: a <code>&lt;nav&gt;</code> of links, the current one marked{' '}
    <code>aria-current="page"</code>. The indicator grows on the default spatial spring when the
    selection moves.
  </p>

  <section aria-labelledby="vertical-heading">
    <h2 id="vertical-heading">Vertical items</h2>
    <div class="docs-nav-frame">
      <nav class="m3e-short-navigation-bar" aria-label="Vertical example" data-testid="short-vertical">
        <NavItems items={items} prefix="v" />
      </nav>
    </div>
    <div class="docs-nav-frame">
      <nav class="m3e-short-navigation-bar" aria-label="Disabled example" data-testid="short-disabled">
        <NavItems items={withDisabled} prefix="d" />
      </nav>
    </div>
    <div class="docs-nav-frame">
      <nav class="m3e-short-navigation-bar" aria-label="Icon-only example" data-testid="short-icons">
        <NavItems items={iconOnly} prefix="i" />
      </nav>
    </div>
  </section>

  <section aria-labelledby="horizontal-heading">
    <h2 id="horizontal-heading">Horizontal items</h2>
    <p>
      <code>m3e-short-navigation-bar--horizontal</code>: icons before labels, items centered (the
      medium-width configuration).
    </p>
    <div class="docs-nav-frame docs-nav-frame--wide">
      <nav
        class="m3e-short-navigation-bar m3e-short-navigation-bar--horizontal"
        aria-label="Horizontal example"
        data-testid="short-horizontal"
      >
        <NavItems items={items} prefix="h" />
      </nav>
    </div>
  </section>

  <section aria-labelledby="element-heading">
    <h2 id="element-heading">Element</h2>
    <p>
      <code>&lt;m3e-short-navigation-bar&gt;</code> with <code>&lt;m3e-navigation-item&gt;</code>{' '}
      children renders the same contract; a press moves <code>selected</code> and fires a
      cancelable <code>selection-change</code>.
    </p>
    <div class="docs-nav-frame">
      <m3e-short-navigation-bar label="Element example" selected="home" data-testid="element-bar">
        <m3e-navigation-item value="home" icon="home">Home</m3e-navigation-item>
        <m3e-navigation-item value="search" icon="search">Search</m3e-navigation-item>
        <m3e-navigation-item value="favorite" icon="favorite">Favorites</m3e-navigation-item>
        <m3e-navigation-item value="settings" icon="settings">Settings</m3e-navigation-item>
      </m3e-short-navigation-bar>
    </div>
  </section>

  <section aria-labelledby="react-heading">
    <h2 id="react-heading">React</h2>
    <p><code>&lt;ShortNavigationBar&gt;</code> with buttons: press an item to move the indicator.</p>
    <NavigationPlayground client:only="react" kind="bar" />
  </section>

  <section aria-labelledby="badges-heading">
    <h2 id="badges-heading">Badges</h2>
    <p>A badge on the destination's icon (Compose puts a <code>BadgedBox</code> in the item's icon; <code>NavigationSuiteScaffold</code> builds it in). Set <code>badge</code> on <code>&lt;m3e-navigation-item&gt;</code> or on the React destination: empty (or <code>true</code>) for the dot, a number for a count (<code>999+</code> above 999), other short text as is. The badge's hidden text is read after the label ("Inbox 8", "Chat New notification"); <code>badge-label</code> / <code>badgeLabel</code> replaces it. m3.material.io hides a badge once its destination is selected; Compose leaves that to the app, so remove the badge yourself.</p>
    <div class="docs-nav-frame">
      <nav class="m3e-short-navigation-bar" aria-label="Badges example" data-testid="short-badges">
        <NavItems items={badged} prefix="b" />
      </nav>
    </div>
    <div class="docs-nav-frame docs-nav-frame--wide">
      <nav
        class="m3e-short-navigation-bar m3e-short-navigation-bar--horizontal"
        aria-label="Horizontal badges example"
        data-testid="short-badges-horizontal"
      >
        <NavItems items={badged} prefix="bh" />
      </nav>
    </div>
    <div class="docs-nav-frame">
      <m3e-short-navigation-bar label="Element badges example" selected="home" data-testid="element-badges">
        <m3e-navigation-item value="home" icon="home">Home</m3e-navigation-item>
        <m3e-navigation-item value="inbox" icon="inbox" badge="8">Inbox</m3e-navigation-item>
        <m3e-navigation-item value="chat" icon="chat" badge="">Chat</m3e-navigation-item>
        <m3e-navigation-item value="mail" icon="mail" badge="1200" badge-label="1200 unread">Mail</m3e-navigation-item>
      </m3e-short-navigation-bar>
    </div>
    <NavigationPlayground client:only="react" kind="bar-badges" />
  </section>

  <section aria-labelledby="legacy-heading" data-deprecated>
    <h2 id="legacy-heading">Navigation bar (deprecated)</h2>
    <DeprecationBanner
      name="the legacy navigation bar"
      apis={['NavigationBar', '.m3e-navigation-bar']}
      replacement="the short navigation bar"
      href="#vertical-heading">It has no element.</DeprecationBanner
    >
    <div class="docs-nav-frame">
      <nav class="m3e-navigation-bar" aria-label="Legacy example" data-testid="legacy-bar">
        <NavItems items={items} prefix="l" />
      </nav>
    </div>
    <p>Compose's <code>NavigationBarItem</code> takes the same badge in its icon (<code>BadgeSamples.kt</code>), so the legacy bar shows it too:</p>
    <div class="docs-nav-frame">
      <nav class="m3e-navigation-bar" aria-label="Legacy badges example" data-testid="legacy-badges">
        <NavItems items={badged} prefix="lb" />
      </nav>
    </div>
  </section>
</Base>

<script>
  import '@kyralabs/m3exp-web/elements';
</script>
