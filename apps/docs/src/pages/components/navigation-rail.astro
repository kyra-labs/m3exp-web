---
import DeprecationBanner from '../../components/DeprecationBanner.astro';
import NavItems, { type Item } from '../../components/NavItems.astro';
import Sources from '../../components/Sources.astro';
import StateEventsNote from '../../components/StateEventsNote.astro';
import NavigationPlayground from '../../islands/NavigationPlayground.tsx';
import Base from '../../layouts/Base.astro';

const items: Item[] = [
  { icon: 'home', label: 'Home', selected: true },
  { icon: 'search', label: 'Search' },
  { icon: 'favorite', label: 'Favorites' },
  { icon: 'settings', label: 'Settings' },
];
// Badges (badge.css on the icon): none, a count, the dot, 999+.
const badged: Item[] = [
  { icon: 'home', label: 'Home', selected: true },
  { icon: 'inbox', label: 'Inbox', badge: '8' },
  { icon: 'chat', label: 'Chat', badge: '' },
  { icon: 'mail', label: 'Mail', badge: '999+', badgeLabel: '1200 unread' },
];
---

<Base title="Navigation rail">
  <link rel="stylesheet" href="/icons/docs-icons.css" slot="head" />
  <h1>Navigation rail</h1>
  <p>
    The wide navigation rail (COMPONENT_SPEC §14; Compose <code>WideNavigationRail</code> and{' '}
    <code>ModalWideNavigationRail</code>). Static rails are plain HTML with m3e-css classes.
    Expanding and collapsing animate the width, the items and the labels on Compose's springs
    (width, spacing and icon position on the default spatial spring, label color on the default
    effects spring), writing one progress per frame so the rail lays out once per frame; a new
    target keeps the current velocity. The modal rail opens over a scrim as a dialog.
  </p>

  <section aria-labelledby="rails-heading">
    <h2 id="rails-heading">Collapsed and expanded</h2>
    <div class="docs-rail-frames">
      <nav class="m3e-wide-navigation-rail" aria-label="Collapsed example" data-testid="rail-collapsed">
        <div class="m3e-wide-navigation-rail__header">
          <button
            type="button"
            class="m3e-icon-button m3e-icon-button--standard docs-rail-menu"
            aria-label="Expand"
          >
            <span class="m3e-icon" aria-hidden="true">menu</span>
          </button>
        </div>
        <NavItems items={items} prefix="c" />
      </nav>
      <nav
        class="m3e-wide-navigation-rail m3e-wide-navigation-rail--expanded"
        aria-label="Expanded example"
        data-testid="rail-expanded"
      >
        <div class="m3e-wide-navigation-rail__header">
          <button
            type="button"
            class="m3e-icon-button m3e-icon-button--standard docs-rail-menu"
            aria-label="Collapse"
          >
            <span class="m3e-icon" aria-hidden="true">menu_open</span>
          </button>
        </div>
        <NavItems items={items} prefix="e" />
      </nav>
    </div>
  </section>

  <section aria-labelledby="element-heading">
    <h2 id="element-heading">Animated (element)</h2>
    <p>
      <code>&lt;m3e-wide-navigation-rail&gt;</code> with <code>&lt;m3e-navigation-item&gt;</code>{' '}
      children; other children go to the header. The menu button calls <code>toggle()</code>.
    </p>
    <StateEventsNote events={['selection-change', 'expanded-change']} />
    <div class="docs-rail-frames">
      <m3e-wide-navigation-rail
        label="Element example"
        selected="home"
        data-testid="element-rail"
      >
        <button
          type="button"
          class="m3e-icon-button m3e-icon-button--standard docs-rail-menu"
          aria-label="Expand"
          aria-expanded="false"
          data-rail-toggle
        >
          <span class="m3e-icon" aria-hidden="true">menu</span>
        </button>
        <m3e-navigation-item value="home" icon="home">Home</m3e-navigation-item>
        <m3e-navigation-item value="search" icon="search">Search</m3e-navigation-item>
        <m3e-navigation-item value="favorite" icon="favorite">Favorites</m3e-navigation-item>
        <m3e-navigation-item value="settings" icon="settings">Settings</m3e-navigation-item>
      </m3e-wide-navigation-rail>
    </div>
  </section>

  <section aria-labelledby="modal-heading">
    <h2 id="modal-heading">Modal (element)</h2>
    <p>
      <code>&lt;m3e-modal-wide-navigation-rail&gt;</code>: collapsed it is a collapsed rail;
      expanded it opens over a scrim (the scrim at 32% <code>scrim</code>, a{' '}
      <code>surface-container</code> rail with large corners) as a <code>dialog</code>: focus stays
      inside, Escape or the scrim collapse it and focus returns to the menu button. With{' '}
      <code>hide-on-collapse</code> nothing shows while collapsed and the expanded rail slides in.
    </p>
    <div class="docs-rail-frames">
      <m3e-modal-wide-navigation-rail
        label="Modal example"
        selected="home"
        data-testid="element-modal-rail"
      >
        <button
          type="button"
          class="m3e-icon-button m3e-icon-button--standard docs-rail-menu"
          aria-label="Expand"
          aria-expanded="false"
          data-rail-toggle
        >
          <span class="m3e-icon" aria-hidden="true">menu</span>
        </button>
        <m3e-navigation-item value="home" icon="home">Home</m3e-navigation-item>
        <m3e-navigation-item value="search" icon="search">Search</m3e-navigation-item>
        <m3e-navigation-item value="favorite" icon="favorite">Favorites</m3e-navigation-item>
        <m3e-navigation-item value="settings" icon="settings">Settings</m3e-navigation-item>
      </m3e-modal-wide-navigation-rail>
      <div class="docs-rail-dismissible">
        <m3e-modal-wide-navigation-rail
          label="Dismissible example"
          selected="home"
          hide-on-collapse
          data-testid="element-dismissible-rail"
        >
          <m3e-navigation-item value="home" icon="home">Home</m3e-navigation-item>
          <m3e-navigation-item value="search" icon="search">Search</m3e-navigation-item>
          <m3e-navigation-item value="settings" icon="settings">Settings</m3e-navigation-item>
        </m3e-modal-wide-navigation-rail>
        <button type="button" class="m3e-button m3e-button--filled" data-testid="open-dismissible">
          <span class="m3e-button__label">Open modal rail</span>
        </button>
      </div>
    </div>
  </section>

  <section aria-labelledby="react-heading">
    <h2 id="react-heading">React</h2>
    <p>
      <code>&lt;WideNavigationRail&gt;</code>: press an item to move the indicator; the menu button
      switches <code>isExpanded</code>, which animates. <code>&lt;ModalWideNavigationRail&gt;</code>:{' '}
      <code>isExpanded</code> + <code>onExpandedChange</code> (Escape and the scrim ask to collapse).
    </p>
    <NavigationPlayground client:only="react" kind="rail" />
  </section>

  <section aria-labelledby="badges-heading">
    <h2 id="badges-heading">Badges</h2>
    <p>A badge on the destination's icon (Compose puts a <code>BadgedBox</code> in the item's icon; <code>NavigationSuiteScaffold</code> builds it in): <code>badge</code> on <code>&lt;m3e-navigation-item&gt;</code> or on the React destination, empty (or <code>true</code>) for the dot, a number for a count (<code>999+</code> above 999), other short text as is; <code>badge-label</code> / <code>badgeLabel</code> replaces the hidden text read after the label. The badge moves with the icon while the rail expands; in the expanded rail the label is drawn over it, as Compose places the label last.</p>
    <div class="docs-rail-frames">
      <nav class="m3e-wide-navigation-rail" aria-label="Collapsed badges example" data-testid="rail-badges-collapsed">
        <NavItems items={badged} prefix="bc" />
      </nav>
      <nav
        class="m3e-wide-navigation-rail m3e-wide-navigation-rail--expanded"
        aria-label="Expanded badges example"
        data-testid="rail-badges-expanded"
      >
        <NavItems items={badged} prefix="be" />
      </nav>
      <m3e-wide-navigation-rail label="Element badges example" selected="home" data-testid="element-badges-rail">
        <m3e-navigation-item value="home" icon="home">Home</m3e-navigation-item>
        <m3e-navigation-item value="inbox" icon="inbox" badge="8">Inbox</m3e-navigation-item>
        <m3e-navigation-item value="chat" icon="chat" badge="">Chat</m3e-navigation-item>
        <m3e-navigation-item value="mail" icon="mail" badge="1200" badge-label="1200 unread">Mail</m3e-navigation-item>
      </m3e-wide-navigation-rail>
    </div>
    <NavigationPlayground client:only="react" kind="rail-badges" />
  </section>

  <section aria-labelledby="legacy-heading" data-deprecated>
    <h2 id="legacy-heading">Navigation rail (deprecated)</h2>
    <DeprecationBanner
      name="the legacy navigation rail"
      apis={['NavigationRail', '.m3e-navigation-rail']}
      replacement="the wide navigation rail"
      href="#rails-heading">It has no element and no animation.</DeprecationBanner
    >
    <div class="docs-rail-frames">
      <nav class="m3e-navigation-rail" aria-label="Legacy example" data-testid="legacy-rail">
        <NavItems items={items} prefix="l" />
      </nav>
      <nav class="m3e-navigation-rail" aria-label="Legacy icon-only example" data-testid="legacy-rail-icons">
        <NavItems items={items.map((item) => ({ ...item, iconOnly: true }))} prefix="li" />
      </nav>
    </div>
    <p>Compose's <code>NavigationRailItem</code> takes the same badge in its icon, so the legacy rail shows it too:</p>
    <div class="docs-rail-frames">
      <nav class="m3e-navigation-rail" aria-label="Legacy badges example" data-testid="legacy-rail-badges">
        <NavItems items={badged} prefix="lb" />
      </nav>
    </div>
  </section>

  <Sources>
    <p>
      androidx Compose Material3 1.5.0-beta01 (<code>19991f2c</code>):{' '}
      <code>NavigationRailCollapsedTokens.kt</code>, <code>NavigationRailExpandedTokens.kt</code>,{' '}
      <code>NavigationRailColorTokens.kt</code>, <code>NavigationRailBaselineItemTokens.kt</code>,{' '}
      <code>NavigationRailVerticalItemTokens.kt</code>,{' '}
      <code>NavigationRailHorizontalItemTokens.kt</code> and <code>ScrimTokens.kt</code> as read by{' '}
      <code>WideNavigationRail.kt</code> (the springs L324–325, L593–600, L732 and L826–831; the
      width measure policy L373–476; <code>placeAnimatedLabelAndIcon</code> L1103–1199;{' '}
      <code>WideNavigationRailDefaults</code> L1251–1252 and L1285–1287; the modal container
      L1537–1541), <code>WideNavigationRailState.kt</code> (L87) and <code>NavigationItem.kt</code>{' '}
      (L488–493, L1212); androidMain <code>WideNavigationRail.android.kt</code> and{' '}
      <code>res/values/strings.xml</code> (L139–142); <code>Scrim.kt</code>;{' '}
      <code>NavigationRailSamples.kt</code> (the responsive, modal and dismissible modal samples);
      the legacy <code>NavigationRail.kt</code> (badge bounds L542). Values in{' '}
      <code>components/navigation-defaults.css</code> (lines in <code>PARITY.md</code>).
    </p>
    <p>
      SOURCES register #32; DECISIONS D4 for the legacy navigation rail.
    </p>
  </Sources>
</Base>

<script>
  import '@kyralabs/m3exp-web/elements';

  // Compose's samples: the header menu button toggles the rail and announces its state.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-rail-toggle]')) {
    const rail = button.closest<HTMLElement & { toggle(): void; expanded?: boolean }>(
      'm3e-wide-navigation-rail, m3e-modal-wide-navigation-rail',
    )!;
    const sync = () => {
      const expanded = Boolean(rail.expanded);
      button.setAttribute('aria-expanded', String(expanded));
      button.setAttribute('aria-label', expanded ? 'Collapse' : 'Expand');
      button.querySelector('.m3e-icon')!.textContent = expanded ? 'menu_open' : 'menu';
    };
    button.addEventListener('click', () => {
      rail.toggle();
    });
    rail.addEventListener('expanded-change', (e) => {
      if (e.target !== rail) return; // state events bubble in 1.x (DECISIONS D25)
      queueMicrotask(sync);
    });
  }
  const dismissible = document.querySelector<HTMLElement & { expand(): void }>(
    '[data-testid="element-dismissible-rail"]',
  )!;
  document.querySelector('[data-testid="open-dismissible"]')!.addEventListener('click', () => {
    dismissible.expand();
  });
</script>
