---
import PrimitivesPlayground from '../../islands/PrimitivesPlayground.tsx';
import Base from '../../layouts/Base.astro';

const containers = [
  ['surface', ''],
  ['container-lowest', 'm3e-surface--container-lowest'],
  ['container-low', 'm3e-surface--container-low'],
  ['container', 'm3e-surface--container'],
  ['container-high', 'm3e-surface--container-high'],
  ['container-highest', 'm3e-surface--container-highest'],
] as const;
const levels = [0, 1, 2, 3, 4, 5] as const;
const shapes = ['none', 'extra-small', 'small', 'medium', 'large', 'extra-large', 'full'] as const;
const icons = ['home', 'search', 'favorite', 'settings', 'star', 'delete'] as const;
---

<Base title="Primitives">
  <link rel="stylesheet" href="/icons/docs-icons.css" slot="head" />
  <h1>Primitives</h1>
  <p>
    Surface, Icon, state layer and focus ring (COMPONENT_SPEC §39). Every component builds on these;
    none re-implements its own state layer.
  </p>

  <section aria-labelledby="surface-heading">
    <h2 id="surface-heading">Surface</h2>
    <p>
      Tonal containers (no surface tint), <code>--variant</code> (surface variant colors), the six
      elevation levels and the corner shapes (<code>--shape-none</code> to <code>--shape-full</code>).
    </p>
    <ul class="docs-tiles">
      {
        containers.map(([label, modifier]) => (
          <li class:list={['docs-tile m3e-surface m3e-surface--shape-medium', modifier]}>
            <code>{label}</code>
          </li>
        ))
      }
      <li class="docs-tile m3e-surface m3e-surface--variant m3e-surface--shape-medium" data-testid="surface-variant">
        <code>variant</code>
      </li>
    </ul>
    <ul class="docs-tiles">
      {
        levels.map((level) => (
          <li
            class={`docs-tile m3e-surface m3e-surface--container-low m3e-surface--shape-medium m3e-surface--elevation-${String(level)}`}
          >
            <code>level{level}</code>
          </li>
        ))
      }
    </ul>
    <ul class="docs-tiles" data-testid="surface-shapes">
      {
        shapes.map((shape) => (
          <li class={`docs-tile m3e-surface m3e-surface--container-highest m3e-surface--shape-${shape}`}>
            <code>{shape}</code>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="icon-heading">
    <h2 id="icon-heading">Icon</h2>
    <p>
      <code>&lt;m3e-icon&gt;</code>, React <code>&lt;Icon&gt;</code> and{' '}
      <code>.m3e-icon</code> render the same DOM. Rows: default, <code>fill</code>, weight 700, grade
      −25 with optical size 20.
    </p>
    <div class="docs-icon-rows">
      <p>{icons.map((name) => <m3e-icon name={name} />)}</p>
      <p>{icons.map((name) => <m3e-icon name={name} fill />)}</p>
      <p>{icons.map((name) => <m3e-icon name={name} weight="700" />)}</p>
      <p>{icons.map((name) => <m3e-icon name={name} grade="-25" optical-size="20" />)}</p>
      <p>
        <m3e-icon name="check_circle" label="Done" />
        <span class="m3e-icon" data-fill aria-hidden="true">check_circle</span>
      </p>
    </div>
  </section>

  <section aria-labelledby="state-heading">
    <h2 id="state-heading">State layer and focus ring</h2>
    <p>
      Hover, keyboard focus (<kbd>Tab</kbd>) and press the tiles. The ripple grows from the press
      point; the focus ring only appears for keyboard focus. Like Compose's inset focus ring, it
      grows on the fast spatial spring and shrinks back on the fast effects spring (no motion with
      reduced motion). A component with its own <code>transition</code> lists{' '}
      <code>var(--_m3e-focus-ring-transition, outline-width, outline-offset)</code> first.
    </p>
    <div class="docs-tiles docs-tiles--demo" id="state-demo">
      <button
        type="button"
        class="docs-tile m3e-surface m3e-surface--container-high m3e-surface--shape-medium m3e-state-layer m3e-focus-ring"
      >
        <m3e-icon name="add" />
        Surface
      </button>
      <button
        type="button"
        class="docs-tile docs-tile--primary m3e-surface--shape-full m3e-state-layer m3e-focus-ring"
      >
        <m3e-icon name="star" fill />
        Primary
      </button>
      <button
        type="button"
        class="docs-tile m3e-surface m3e-surface--container-high m3e-surface--shape-medium m3e-state-layer m3e-focus-ring m3e-focus-ring--inward"
      >
        <m3e-icon name="settings" />
        Inward ring
      </button>
      <button
        type="button"
        class="docs-tile m3e-surface m3e-surface--container-high m3e-surface--shape-medium m3e-state-layer m3e-focus-ring"
        aria-disabled="true"
      >
        <m3e-icon name="delete" />
        Disabled
      </button>
    </div>
  </section>

  <section aria-labelledby="ripple-heading">
    <h2 id="ripple-heading">Ripple for plain HTML</h2>
    <p>
      Plain-HTML components get their hover, focus and pressed overlays from m3e-css alone; the
      ripple needs JS. <code>import '@kyralabs/m3e-elements/ripple.js'</code> adds it to every
      button, icon button, assist chip, <code>.m3e-state-layer</code>, interactive card (pressed
      through <code>.m3e-card__action</code>) and navigation item (drawn on its indicator) in the
      document, current and future, through one set of delegated listeners. Hosts that m3e-react or{' '}
      <code>attachRipple</code> already drive carry <code>data-ripple</code> and are skipped.{' '}
      <code>attachAutoRipple(root, signal)</code> does the same within one root; this demo uses it.
    </p>
    <div id="auto-ripple-demo">
      <div class="docs-button-row">
        <button type="button" class="m3e-button m3e-button--filled">Button</button>
        <button
          type="button"
          class="m3e-icon-button m3e-icon-button--filled"
          aria-label="Favorite"
        >
          <span class="m3e-icon" aria-hidden="true">favorite</span>
        </button>
        <button type="button" class="m3e-assist-chip">
          <span class="m3e-icon" aria-hidden="true">add</span>
          <span class="m3e-assist-chip__label">Add to calendar</span>
        </button>
      </div>
      <ul class="docs-cards">
        <li class="m3e-card m3e-card--outlined m3e-card--interactive">
          <div class="docs-card-body">
            <h3 class="docs-card-title">
              <a class="m3e-card__action" href="#ripple-heading">Outlined card</a>
            </h3>
            <p>The ripple grows on the card.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section aria-labelledby="react-heading">
    <h2 id="react-heading">React</h2>
    <p>
      <code>&lt;Icon name fill weight grade opticalSize label&gt;</code> and{' '}
      <code>&lt;Surface container variant elevation shape&gt;</code> render the same DOM as the rows
      above. <code>useStateLayer(hostRef?)</code> drives the ripple on your own element: spread its{' '}
      <code>stateLayerProps</code> on the host and pass <code>onPressStart</code> /{' '}
      <code>onPressEnd</code> to React Aria's <code>usePress</code> or <code>useButton</code>.
    </p>
    <PrimitivesPlayground client:only="react" />
  </section>
</Base>

<script>
  import { attachAutoRipple, attachRipple } from '@kyralabs/m3exp-web/elements';

  for (const tile of document.querySelectorAll<HTMLElement>('#state-demo .m3e-state-layer')) {
    attachRipple(tile, new AbortController().signal);
  }
  const demo = document.querySelector<HTMLElement>('#auto-ripple-demo');
  if (demo) attachAutoRipple(demo, new AbortController().signal);
</script>
