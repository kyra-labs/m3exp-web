---
import ProgressPlayground from '../../islands/ProgressPlayground.tsx';
import Base from '../../layouts/Base.astro';

const values = [0, 0.01, 0.3, 0.7, 1] as const;
const linearParts = ['track', 'indicator', 'stop'] as const;
const indeterminateParts = ['track', 'indicator', 'track', 'indicator', 'track'] as const;
const valueStyle = (v: number) => `--m3e-comp-progress-indicator-value: ${String(v)}`;
---

<Base title="Progress indicators">
  <h1>Progress indicators</h1>
  <p>
    Linear and circular progress indicators (COMPONENT_SPEC §8; Compose <code>LinearProgressIndicator</code>, <code>CircularProgressIndicator</code>, <code>LinearWavyProgressIndicator</code>, <code>CircularWavyProgressIndicator</code>), flat or wavy, determinate or indeterminate, in the default 4dp or the thick 8dp configuration. Flat indicators are plain HTML with m3e-css classes, indeterminate ones included (CSS keyframes); the value is <code>--m3e-comp-progress-indicator-value</code> (0–1) next to <code>aria-valuenow</code>. Wavy ones are drawn by <code>&lt;m3e-linear-progress&gt;</code> / <code>&lt;m3e-circular-progress&gt;</code> and <code>&lt;LinearProgress&gt;</code> / <code>&lt;CircularProgress&gt;</code> (React), which also run value changes on Compose's progress spring.
  </p>

  <section aria-labelledby="linear-heading">
    <h2 id="linear-heading">Linear, flat (CSS only)</h2>
    <p>
      The track starts after a gap of min(progress, 4dp); the stop indicator marks the end. Indeterminate: two lines run Compose's keyframes on a 1750ms cycle.
    </p>
    <div class="docs-progress-column" data-testid="linear-flat">
      {
        values.map((v) => (
          <div
            class="m3e-linear-progress"
            role="progressbar"
            aria-label={`Linear ${String(Math.round(v * 100))}%`}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow={String(Math.round(v * 100))}
            style={valueStyle(v)}
          >
            {linearParts.map((part) => (
              <span class={`m3e-linear-progress__${part}`} />
            ))}
          </div>
        ))
      }
      <div
        class="m3e-linear-progress m3e-linear-progress--thick"
        role="progressbar"
        aria-label="Linear thick 40%"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="40"
        style={valueStyle(0.4)}
      >
        {linearParts.map((part) => <span class={`m3e-linear-progress__${part}`} />)}
      </div>
      <div class="m3e-linear-progress" role="progressbar" aria-label="Linear indeterminate">
        {indeterminateParts.map((part) => <span class={`m3e-linear-progress__${part}`} />)}
      </div>
      <div
        class="m3e-linear-progress m3e-linear-progress--thick"
        role="progressbar"
        aria-label="Linear thick indeterminate"
      >
        {indeterminateParts.map((part) => <span class={`m3e-linear-progress__${part}`} />)}
      </div>
    </div>
  </section>

  <section aria-labelledby="circular-heading">
    <h2 id="circular-heading">Circular, flat (CSS only)</h2>
    <p>
      From 12 o'clock, clockwise; the track follows after the gap. Indeterminate: no track, the arc rotates (1080° plus a 90° step every 1.5s) and sweeps between 10% and 87% on a 6s cycle.
    </p>
    <div class="docs-progress-row" data-testid="circular-flat">
      {
        values.map((v) => (
          <div
            class="m3e-circular-progress"
            role="progressbar"
            aria-label={`Circular ${String(Math.round(v * 100))}%`}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow={String(Math.round(v * 100))}
            style={valueStyle(v)}
          >
            <svg class="m3e-circular-progress__svg" aria-hidden="true" focusable="false">
              <circle class="m3e-circular-progress__track" />
              <circle class="m3e-circular-progress__indicator" />
            </svg>
          </div>
        ))
      }
      <div
        class="m3e-circular-progress m3e-circular-progress--thick"
        role="progressbar"
        aria-label="Circular thick 40%"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="40"
        style={valueStyle(0.4)}
      >
        <svg class="m3e-circular-progress__svg" aria-hidden="true" focusable="false">
          <circle class="m3e-circular-progress__track" />
          <circle class="m3e-circular-progress__indicator" />
        </svg>
      </div>
      <div class="m3e-circular-progress" role="progressbar" aria-label="Circular indeterminate">
        <svg class="m3e-circular-progress__svg" aria-hidden="true" focusable="false">
          <circle class="m3e-circular-progress__track" />
          <circle class="m3e-circular-progress__indicator" />
        </svg>
      </div>
    </div>
  </section>

  <section aria-labelledby="wavy-heading">
    <h2 id="wavy-heading">Wavy (custom elements)</h2>
    <p>
      <code>&lt;m3e-linear-progress shape="wavy" value="0.4"&gt;</code> and <code>&lt;m3e-circular-progress&gt;</code>: the wave travels one wavelength per second (it holds still with <code>prefers-reduced-motion</code>); determinate waves flatten at ≤ 10% and ≥ 95%, tweening their amplitude. The circular wave is a star with one point per 15dp of circumference, morphed from the track's circle.
    </p>
    <div class="docs-progress-column" data-testid="wavy-linear">
      {
        values.map((v) => (
          <m3e-linear-progress shape="wavy" value={String(v)} aria-label={`Wavy ${String(Math.round(v * 100))}%`} />
        ))
      }
      <m3e-linear-progress shape="wavy" thickness="thick" value="0.4" aria-label="Wavy thick 40%" />
      <m3e-linear-progress shape="wavy" aria-label="Wavy indeterminate" />
      <m3e-linear-progress shape="wavy" thickness="thick" aria-label="Wavy thick indeterminate" />
    </div>
    <div class="docs-progress-row" data-testid="wavy-circular">
      {
        values.map((v) => (
          <m3e-circular-progress shape="wavy" value={String(v)} aria-label={`Wavy circular ${String(Math.round(v * 100))}%`} />
        ))
      }
      <m3e-circular-progress shape="wavy" thickness="thick" value="0.4" aria-label="Wavy circular thick 40%" />
      <m3e-circular-progress shape="wavy" aria-label="Wavy circular indeterminate" />
    </div>
  </section>

  <section aria-labelledby="rtl-heading">
    <h2 id="rtl-heading">Right to left</h2>
    <p>Linear indicators mirror; circular ones do not (m3.material.io).</p>
    <div dir="rtl" class="docs-progress-column" data-testid="rtl">
      <m3e-linear-progress value="0.4" aria-label="RTL 40%" />
      <m3e-linear-progress shape="wavy" value="0.4" aria-label="RTL wavy 40%" />
      <m3e-circular-progress value="0.4" aria-label="RTL circular 40%" />
    </div>
  </section>

  <section aria-labelledby="animate-heading">
    <h2 id="animate-heading">Value changes</h2>
    <p>
      Setting <code>value</code> springs to it on <code>ProgressIndicatorDefaults.ProgressAnimationSpec</code> (damping 1, stiffness 50; interrupted changes keep their velocity).
    </p>
    <div class="docs-progress-column" data-testid="animate">
      <m3e-linear-progress id="animate-linear" value="0.1" aria-label="Animated" />
      <m3e-linear-progress id="animate-wavy" shape="wavy" value="0.1" aria-label="Animated wavy" />
      <m3e-circular-progress id="animate-circular" shape="wavy" value="0.1" aria-label="Animated circular" />
      <div class="docs-controls">
        <label>
          Value
          <input id="animate-input" type="range" min="0" max="1" step="0.01" value="0.1" />
        </label>
      </div>
    </div>
  </section>

  <section aria-labelledby="react-heading">
    <h2 id="react-heading">React</h2>
    <p>
      <code>&lt;LinearProgress value shape thickness amplitude wavelength waveSpeed aria-label /&gt;</code> and <code>&lt;CircularProgress …/&gt;</code>.
    </p>
    <ProgressPlayground client:only="react" />
  </section>
</Base>

<script>
  import '@kyralabs/m3exp-web/elements';

  const input = document.getElementById('animate-input') as HTMLInputElement;
  input.addEventListener('input', () => {
    for (const id of ['animate-linear', 'animate-wavy', 'animate-circular'])
      document.getElementById(id)!.setAttribute('value', input.value);
  });
</script>
