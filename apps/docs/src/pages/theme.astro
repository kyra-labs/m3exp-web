---
import Base from '../layouts/Base.astro';

// Starting values for the core color pickers: the baseline palette key tones
// (PaletteTokens.kt@19991f2c Secondary40, Tertiary40, Error40) and a plain grey for the neutrals.
const CORE_COLOR_FIELDS = [
  { key: 'secondary', label: 'Secondary', value: '#625b71' },
  { key: 'tertiary', label: 'Tertiary', value: '#7d5260' },
  { key: 'neutral', label: 'Neutral', value: '#808080' },
  { key: 'neutralVariant', label: 'Neutral variant', value: '#808080' },
  { key: 'error', label: 'Error', value: '#b3261e' },
];
---

<Base title="Theme">
  <h1>Theme</h1>
  <p>
    Every color role from <code>createTheme()</code> (material-color-utilities 0.4.0). Compare with
    Material Theme Builder or the Compose catalog for the same seed, variant and contrast.
  </p>
  <form class="docs-controls" id="theme-form">
    <label>Seed <input name="seed" type="color" value="#6750a4" /></label>
    <label>
      Variant
      <select name="variant" id="variant"></select>
    </label>
    <label>
      Contrast
      <select name="contrast">
        <option value="standard">Standard</option>
        <option value="medium">Medium</option>
        <option value="high">High</option>
      </select>
    </label>
    <label>
      Spec
      <select name="spec">
        <option value="2025">2025</option>
        <option value="2021">2021</option>
      </select>
    </label>
    <fieldset class="docs-core-colors">
      <legend>Core colors (optional; unchecked palettes come from the seed)</legend>
      {
        CORE_COLOR_FIELDS.map(({ key, label, value }) => (
          <div class="docs-core-colors__item">
            <label>
              <input type="checkbox" name="core" value={key} />
              {label}
            </label>
            <input name={key} type="color" value={value} aria-label={`${label} color`} />
          </div>
        ))
      }
    </fieldset>
  </form>
  <p>
    A red seed with the <code>fidelity</code> variant tints every surface red; a grey
    <code>neutral</code> core color keeps the red primary on grey surfaces:
  </p>
  <pre class="docs-code"><code>{`createTheme({
  seed: '#d84848',
  variant: 'fidelity',
  coreColors: { neutral: '#808080', neutralVariant: '#808080' },
});

m3e-theme --seed "#d84848" --variant fidelity \\
  --neutral "#808080" --neutral-variant "#808080"`}</code></pre>
  <p>
    With spec 2025 (tonalSpot, neutral, vibrant, expressive) the outline and surface-variant roles
    come from the neutral palette, so <code>neutralVariant</code> has no effect there.
  </p>
  <div class="docs-schemes">
    <section aria-labelledby="light-heading">
      <h2 id="light-heading">Light</h2>
      <ul class="docs-swatches" id="light"></ul>
    </section>
    <section aria-labelledby="dark-heading">
      <h2 id="dark-heading">Dark</h2>
      <ul class="docs-swatches" id="dark"></ul>
    </section>
  </div>
</Base>

<script>
  import {
    VARIANTS,
    createTheme,
    type CoreColor,
    type SpecVersion,
    type Variant,
  } from '@kyralabs/m3exp-web/theme';

  const form = document.getElementById('theme-form') as HTMLFormElement;
  const variantSelect = document.getElementById('variant') as HTMLSelectElement;
  for (const variant of VARIANTS) {
    variantSelect.append(new Option(variant, variant, variant === 'tonalSpot', variant === 'tonalSpot'));
  }

  function render() {
    const data = new FormData(form);
    const coreColors = Object.fromEntries(
      data.getAll('core').map((key) => [key, String(data.get(String(key)))]),
    ) as Partial<Record<CoreColor, string>>;
    const { tokens } = createTheme({
      seed: String(data.get('seed')),
      coreColors,
      variant: String(data.get('variant')) as Variant,
      contrast: String(data.get('contrast')) as 'standard' | 'medium' | 'high',
      specVersion: String(data.get('spec')) as SpecVersion,
    });
    for (const mode of ['light', 'dark'] as const) {
      const list = document.getElementById(mode)!;
      list.replaceChildren(
        ...Object.entries(tokens[mode] ?? {}).map(([role, hex]) => {
          const item = document.createElement('li');
          item.className = 'docs-swatch';
          const chip = document.createElement('span');
          chip.className = 'docs-swatch__chip';
          chip.setAttribute('aria-hidden', 'true');
          chip.style.backgroundColor = hex;
          const label = document.createElement('code');
          label.textContent = `${role} ${hex}`;
          item.append(chip, label);
          return item;
        }),
      );
    }
  }

  form.addEventListener('input', render);
  render();
</script>
