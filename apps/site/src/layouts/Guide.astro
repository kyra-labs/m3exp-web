---
// A page of a series (the getting-started guides, the foundations): the page title, a lead, the
// content and links to the previous and next page of its series (data/nav.ts order).
import Site from './Site.astro';
import { FOUNDATIONS, GUIDES } from '../data/nav';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const series = [
  { label: 'Guides', pages: GUIDES },
  { label: 'Foundations', pages: FOUNDATIONS },
].find((s) => s.pages.some((page) => page.href === Astro.url.pathname));
const pages = series?.pages ?? [];
const index = pages.findIndex((page) => page.href === Astro.url.pathname);
const previous = index > 0 ? pages[index - 1] : undefined;
const next = index >= 0 ? pages[index + 1] : undefined;
---

<Site title={title} description={description}>
  <h1>{title}</h1>
  <p class="site-lead">{description}</p>
  <slot />
  <nav class="site-pager" aria-label={series?.label ?? 'Pages'} data-pagefind-ignore>
    {
      previous && (
        <a class="m3e-button m3e-button--outlined m3e-button--size-m site-pager__previous" href={previous.href}>
          <span class="m3e-icon" aria-hidden="true">
            arrow_back
          </span>
          {previous.label}
        </a>
      )
    }
    {
      next && (
        <a class="m3e-button m3e-button--tonal m3e-button--size-m site-pager__next" href={next.href}>
          {next.label}
          <span class="m3e-icon" aria-hidden="true">
            arrow_forward
          </span>
        </a>
      )
    }
  </nav>
</Site>
