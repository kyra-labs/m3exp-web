---
// The site shell (DECISIONS D27): a top app bar with search, a navigation drawer (permanent from
// the large window size class, modal below) and the page. Everything is m3e-css markup, so the
// page reads with JavaScript off; src/scripts/chrome.ts adds the drawer, search and theme menu.
import { getImage, Image } from 'astro:assets';
import { space } from '@kyralabs/m3e-tokens';
import '../styles/base.css';
import '../styles/site.css';
import NavDrawer from '../components/NavDrawer.astro';
import TopBar from '../components/TopBar.astro';
import { kyraLogo, OG_IMAGE } from '../data/brand';
import {
  NPM_URL,
  ORG_NAME,
  ORG_URL,
  PLAYGROUND_URL,
  REPO_URL,
  SITE_NAME,
  SITE_TAGLINE,
} from '../data/site';
import { breadcrumbList, homeGraph, jsonLd } from '../lib/structured-data';
import themeInit from '../scripts/theme-init.js?raw';

interface Props {
  /** The page title, without the site name. */
  title: string;
  /** One or two sentences for search engines and link previews. */
  description: string;
  /** Lets the content use the full width (galleries, wide demos) instead of the reading width. */
  wide?: boolean;
  /** Left out of the Pagefind index (the 404 page). */
  noindex?: boolean;
}

const { title, description, wide = false, noindex = false } = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const fullTitle = isHome ? `${SITE_NAME}: ${SITE_TAGLINE}` : `${title} · ${SITE_NAME}`;
const canonical = new URL(pathname, Astro.site).href;
const ogImage = new URL(OG_IMAGE.image.src, Astro.site).href;

// The Kyra Labs logo at the footer's height (the logo is wider than tall), and a 512 px wide PNG
// for the Organization's schema.org logo (search engines ask for at least 112 px).
const kyraHeight = space.space400;
const kyraWidth = Math.round((kyraHeight * kyraLogo.width) / kyraLogo.height);
const orgLogo = await getImage({ src: kyraLogo, width: 512, format: 'png' });
const structuredData = noindex
  ? null
  : isHome
    ? homeGraph(description, new URL(orgLogo.src, Astro.site).href)
    : breadcrumbList(pathname, title);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {
      /* The m3e cascade layer order, before any stylesheet: pages load single m3e-css files, and
         only css/index.css declares the order, so the bundle's file order would decide it. */
    }
    <style is:inline>
      @layer m3e.tokens, m3e.base, m3e.components;
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={ORG_NAME} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="M3E" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_IMAGE.image.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.image.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={OG_IMAGE.alt} />
    {
      structuredData && (
        <script is:inline type="application/ld+json" set:html={jsonLd(structuredData)} />
      )
    }
    <script is:inline set:html={themeInit} />
    <slot name="head" />
  </head>
  <body>
    <a class="site-skip" href="#main">Skip to content</a>
    <TopBar />
    <div class="site-frame">
      <NavDrawer pathname={pathname} />
      <main id="main" class:list={['site-main', { 'site-main--wide': wide }]} tabindex="-1">
        <div class="site-content" data-pagefind-body={noindex ? undefined : ''}>
          <slot />
        </div>
        <footer class="site-footer">
          <slot name="footer" />
          <div class="site-footer__bar">
            <a class="site-footer__org" href={ORG_URL}>
              <span>{SITE_NAME} by</span>
              <Image
                class="site-footer__logo"
                src={kyraLogo}
                alt={ORG_NAME}
                width={kyraWidth}
                height={kyraHeight}
                densities={[1, 2]}
              />
            </a>
            <ul class="site-footer__links">
              <li><a href="/privacy/">Privacy policy</a></li>
              <li><a href={REPO_URL}>GitHub</a></li>
              <li><a href={NPM_URL}>npm</a></li>
              <li><a href={PLAYGROUND_URL}>Playground</a></li>
            </ul>
          </div>
          <p>
            © {new Date().getFullYear()}
            {ORG_NAME}. Code under the Apache License 2.0. Google Sans Flex (SIL Open Font License
            1.1) and Material Symbols (Apache-2.0) ship with their licenses. "Google", "Google Sans"
            and "Material Design" are trademarks of Google LLC; {SITE_NAME} is an independent Kyra
            Labs project, not affiliated with or endorsed by Google.
          </p>
        </footer>
      </main>
    </div>
    <script>
      import '../scripts/chrome';
    </script>
  </body>
</html>
