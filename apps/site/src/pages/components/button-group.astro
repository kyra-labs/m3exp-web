---
import '@kyralabs/m3e-css/button.css';
import '@kyralabs/m3e-css/button-group.css';
import ComponentPage from '../../layouts/ComponentPage.astro';
---

<ComponentPage
  slug="button-group"
  examples={[
    { name: 'standard', title: 'Standard', description: 'Press and hold a button: it grows on a spring and its neighbors make room.' },
    { name: 'connected', title: 'Connected, single selection', description: 'A segmented row that replaces the segmented button: `selectionMode="single"` makes a radio group; `disallowEmptySelection` keeps one selected.' },
    { name: 'multiple', title: 'Connected, multiple selection', description: '`selectionMode="multiple"` makes each button a toggle.' },
  ]}
/>
