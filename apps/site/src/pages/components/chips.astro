---
import '@kyralabs/m3e-css/assist-chip.css';
import '@kyralabs/m3e-css/chip-set.css';
import '@kyralabs/m3e-css/filter-chip.css';
import '@kyralabs/m3e-css/input-chip.css';
import '@kyralabs/m3e-css/suggestion-chip.css';
import ComponentPage from '../../layouts/ComponentPage.astro';
---

<ComponentPage
  slug="chips"
  examples={[
    { name: 'assist', title: 'Assist and suggestion chips', description: 'Actions related to the content, flat or elevated. A chip set is one tab stop: the arrow keys move between its chips.' },
    { name: 'filter', title: 'Filter chips', description: 'Toggle filters: native checkboxes in the HTML, so they work in forms without JavaScript.' },
    { name: 'input', title: 'Input chips', description: 'Entities someone entered, removable with the close button, Backspace or Delete. The set is a grid: one row per chip.' },
  ]}
/>
