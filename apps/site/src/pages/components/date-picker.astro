---
import '@kyralabs/m3e-css/button.css';
import '@kyralabs/m3e-css/date-picker.css';
import '@kyralabs/m3e-css/dialog.css';
import '@kyralabs/m3e-css/menu.css';
import '@kyralabs/m3e-css/text-field.css';
import ComponentPage from '../../layouts/ComponentPage.astro';
---

<ComponentPage
  slug="date-picker"
  examples={[
    { name: 'calendar', title: 'Date picker', description: 'The calendar, the year grid (from the month and year button) and the date input (from the pencil), in one. The arrow keys move through the days; Page Up / Down change the month.' },
    { name: 'dialog', title: 'In a dialog', description: 'Compose\'s DatePickerDialog: the picker with Cancel and OK. The value changes only on OK.' },
    { name: 'range', title: 'Date range', description: 'A scrolling list of months with the range band, shown full screen as Compose does, with Save.' },
    { name: 'docked', title: 'Docked', description: 'A date field whose calendar drops down below it (m3.material.io\'s docked picker; Compose has none).' },
  ]}
/>
