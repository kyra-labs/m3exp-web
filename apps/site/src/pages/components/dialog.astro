---
import '@kyralabs/m3e-css/button.css';
import '@kyralabs/m3e-css/dialog.css';
import '@kyralabs/m3e-css/icon-button.css';
import '@kyralabs/m3e-css/text-field.css';
import ComponentPage from '../../layouts/ComponentPage.astro';
---

<ComponentPage
  slug="dialog"
  examples={[
    { name: 'alert', title: 'Alert dialog', description: 'A modal prompt: the page is inert, Tab stays inside, Escape or the scrim ask to close, and focus returns to the button that opened it.' },
    { name: 'full-screen', title: 'Full-screen dialog', description: 'Fills the window below 600px; from 600px it is laid out as a basic dialog.' },
  ]}
/>
