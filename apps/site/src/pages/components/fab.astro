---
import '@kyralabs/m3e-css/fab.css';
import '@kyralabs/m3e-css/switch.css';
import ComponentPage from '../../layouts/ComponentPage.astro';
---

<ComponentPage
  slug="fab"
  examples={[
    { name: 'fab', title: 'FAB sizes', description: 'Baseline (56dp, default), medium and large. A FAB shows only an icon, so it needs an `aria-label`.' },
    { name: 'colors', title: 'Colors', description: 'Primary, secondary and tertiary, each as a container color or the solid color.' },
    { name: 'legacy-small', title: 'Small FAB (deprecated)', description: '**Deprecated (D4):** m3.material.io no longer recommends the small FAB (40dp; its touch target still reaches 48dp). `size=\'small\'` ships until 2.0 and warns once in development.' },
    { name: 'extended', title: 'Extended FAB', description: 'An icon and a label. `isExpanded={false}` collapses it to the icon on a spring; the label stays its accessible name.' },
  ]}
/>
