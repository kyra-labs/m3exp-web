---
import '@kyralabs/m3e-css/fab.css';
import '@kyralabs/m3e-css/floating-toolbar.css';
import ComponentPage from '../../layouts/ComponentPage.astro';
---

<ComponentPage
  slug="floating-toolbar"
  examples={[
    { name: 'horizontal', title: 'Standard and vibrant', description: 'A toolbar has one tab stop: the arrow keys, Home and End move between its items.' },
    { name: 'vertical', title: 'Vertical', description: 'Leading and trailing items show only while the toolbar is expanded.' },
    { name: 'with-fab', title: 'With a FAB', description: 'The FAB toggles the toolbar here; the items collapse into it on the spatial spring.' },
    { name: 'scroll', title: 'Hiding on scroll', description: 'Exit-always: the toolbar leaves when the content scrolls down and returns on any scroll up. `collapse` collapses it instead.' },
  ]}
/>
