---
import '@kyralabs/m3e-css/icon-button.css';
import ComponentPage from '../../layouts/ComponentPage.astro';
---

<ComponentPage
  slug="icon-button"
  examples={[
    { name: 'variants', title: 'Color configurations', description: 'Standard (default) takes the surrounding content color, as in Compose; filled, tonal and outlined have their own. Icon-only controls need an `aria-label`.' },
    { name: 'sizes', title: 'Sizes and widths', description: 'Extra small to extra large, each narrow, default (uniform) or wide.' },
    { name: 'toggle', title: 'Toggles', description: 'With `isSelected` or `defaultSelected` an icon button toggles (`aria-pressed`): the icon fills and the shape morphs.' },
  ]}
/>
