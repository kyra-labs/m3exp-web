---
import '@kyralabs/m3e-css/badge.css';
import '@kyralabs/m3e-css/navigation-bar.css';
import '@kyralabs/m3e-css/navigation-item.css';
import '@kyralabs/m3e-css/short-navigation-bar.css';
import ComponentPage from '../../layouts/ComponentPage.astro';
---

<ComponentPage
  slug="navigation-bar"
  examples={[
    { name: 'short', title: 'Short navigation bar', description: 'Vertical items (the default) and horizontal items, which suit medium windows. Destinations with `href` are links; the selected one is `aria-current="page"`. Badges show a dot or a count.' },
    { name: 'legacy-navigation-bar', title: 'Navigation bar (deprecated)', description: '**Deprecated (D4):** the 80dp `NavigationBar` ships until 2.0. Use the short navigation bar.' },
  ]}
/>
