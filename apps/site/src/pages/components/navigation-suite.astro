---
import '@kyralabs/m3e-css/badge.css';
import '@kyralabs/m3e-css/fab.css';
import '@kyralabs/m3e-css/navigation-item.css';
import '@kyralabs/m3e-css/navigation-suite.css';
import '@kyralabs/m3e-css/short-navigation-bar.css';
import '@kyralabs/m3e-css/wide-navigation-rail.css';
import ComponentPage from '../../layouts/ComponentPage.astro';
---

<ComponentPage
  slug="navigation-suite"
  examples={[
    { name: 'adaptive', title: 'Adaptive navigation', description: 'One set of destinations, shown as the window size class calls for: a short navigation bar below 600px, a collapsed wide rail from 600px and the expanded rail from 1200px. The FAB floats above the bar and heads the rail. Switching keeps the selection and the focus.' },
  ]}
/>
