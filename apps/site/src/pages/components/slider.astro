---
import '@kyralabs/m3e-css/slider.css';
import ComponentPage from '../../layouts/ComponentPage.astro';
---

<ComponentPage
  slug="slider"
  examples={[
    { name: 'standard', title: 'Standard slider', description: 'Continuous with an icon in the track, discrete with stops every 10, and disabled. Each thumb is a native range input: the arrow keys, Page Up / Down, Home and End work.' },
    { name: 'range', title: 'Range slider', description: 'Two thumbs that meet but never cross, each with its own label. The values format as currency.' },
    { name: 'centered-vertical', title: 'Centered and vertical', description: 'A centered slider fills from its middle; a vertical one sizes to its block size.' },
  ]}
/>
