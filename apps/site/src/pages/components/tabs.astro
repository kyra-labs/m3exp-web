---
import '@kyralabs/m3e-css/badge.css';
import ComponentPage from '../../layouts/ComponentPage.astro';
---

<ComponentPage
  slug="tabs"
  examples={[
    { name: 'primary', title: 'Primary tabs', description: 'Icons above the labels, and a badge. Activation is manual, as in Compose: the arrow keys, Home and End move the focus, and Enter, Space or a click selects. Tab moves into the panel.' },
    { name: 'secondary', title: 'Secondary tabs', description: 'For a second level of content. A disabled tab stays focusable (`aria-disabled`), as APG recommends.' },
    { name: 'scrollable', title: 'Scrollable tabs', description: 'With leading icons. The row scrolls the selected tab into view.' },
  ]}
/>
