---
import '@kyralabs/m3e-css/button.css';
import '@kyralabs/m3e-css/dialog.css';
import '@kyralabs/m3e-css/time-picker.css';
import ComponentPage from '../../layouts/ComponentPage.astro';
---

<ComponentPage
  slug="time-picker"
  examples={[
    { name: 'dial', title: 'Clock dial', description: 'Hours, then minutes on the dial, with AM / PM in 12-hour locales. Drag the hand or use the arrow keys.' },
    { name: 'input', title: 'Text input', description: 'Type the hours and minutes; here in 24-hour time.' },
    { name: 'scroll', title: 'Scroll wheels', description: 'The expressive scroll wheels (always vibrant).' },
    { name: 'dialog', title: 'In a dialog', description: 'Compose\'s TimePickerDialog: a title, the picker, Cancel and OK.' },
  ]}
/>
