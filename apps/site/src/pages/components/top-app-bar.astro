---
import '@kyralabs/m3e-css/top-app-bar.css';
import ComponentPage from '../../layouts/ComponentPage.astro';
---

<ComponentPage
  slug="top-app-bar"
  examples={[
    { name: 'variants', title: 'Variants', description: 'Small, center-aligned, medium flexible and large flexible. The flexible bars take a subtitle, and the title is a heading at the level you pick (`headingLevel`, default 1).' },
    { name: 'scroll', title: 'Collapsing on scroll', description: 'Exit-until-collapsed: the expanded row collapses to the small bar as the content scrolls, and settles on a spring when scrolling stops. In HTML, `attachTopAppBarScroll` runs the same code. The other behaviors are `pinned` and `enter-always`.' },
  ]}
/>
