---
// The HTML version of each component example, live: m3e-css markup plus the custom elements it
// uses, with no framework. Linked from the example's HTML tab; left out of search and the
// sitemap. tests/examples.spec.ts loads every one.
import '@kyralabs/m3exp-web/css/index.css';
import '../../../generated/icons/site-icons.css';
import '../../../styles/site.css';
import { COMPONENTS } from '../../../data/components';
import { SITE_NAME } from '../../../data/site';
import { runnableExample } from '../../../lib/example-modules';
import themeInit from '../../../scripts/theme-init.js?raw';

export function getStaticPaths() {
  const files = import.meta.glob<string>('../../../examples/*/*.html', {
    query: '?raw',
    import: 'default',
    eager: true,
  });
  // preview.html is the gallery card's markup, not an example.
  return Object.entries(files)
    .filter(([path]) => !path.endsWith('/preview.html'))
    .map(([path, html]) => {
    const [, slug = '', name = ''] = /examples\/([^/]+)\/([^/]+)\.html$/.exec(path) ?? [];
    return { params: { slug, name }, props: { html } };
  });
}

interface Props {
  html: string;
}

const { slug, name } = Astro.params;
const html = runnableExample(Astro.props.html);
const entry = COMPONENTS.find((c) => c.slug === slug);
const title = `${entry?.title ?? slug}: ${name.replace(/-/g, ' ')} (HTML)`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <title>{`${title} · ${SITE_NAME}`}</title>
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline set:html={themeInit} />
    <script is:inline>
      // Example scripts await m3e-elements entries through this (lib/example-modules.ts); the
      // page script below provides the loader once it has registered the example's elements.
      let provide;
      const loader = new Promise((resolve) => (provide = resolve));
      window.m3eProvide = provide;
      window.m3eImport = async (entry) => (await loader)(entry);
    </script>
  </head>
  <body class="site-example-page">
    <main>
      <h1 class="site-example-page__title">{title}</h1>
      <p>
        <a href={`/components/${slug}/#example-${name}`}>Back to the {entry?.title ?? slug} page</a>
      </p>
      <div class="site-example__preview site-example-page__demo" set:html={html} />
    </main>
    <script>
      import '@kyralabs/m3e-elements/ripple.js';
      import { TAG_ENTRY, ELEMENT_ENTRIES } from '../../../generated/element-entries';

      const entries = new Set(
        [...document.querySelectorAll('*')]
          .map((el) => TAG_ENTRY[el.localName])
          .filter((e): e is string => e !== undefined),
      );
      await Promise.all([...entries].map((e) => ELEMENT_ENTRIES[e]?.()));
      (window as unknown as { m3eProvide: (load: (entry: string) => unknown) => void }).m3eProvide(
        (entry) => {
          const load = ELEMENT_ENTRIES[entry];
          if (!load) throw new Error(`m3e-elements has no entry ${entry}`);
          return load();
        },
      );
      document.body.dataset['ready'] = '';
    </script>
  </body>
</html>
