---
import { typescale } from '@kyralabs/m3e-tokens';
import CodeBlock from '../../components/CodeBlock.astro';
import ScrollTable from '../../components/ScrollTable.astro';
import Guide from '../../layouts/Guide.astro';
import { kebab } from '../../lib/kebab';

// The 15 roles in display → label order, each with its emphasized style (TypeScaleTokens.kt,
// generated: sizes and line heights in sp, emitted as rem).
const ORDER = ['display', 'headline', 'title', 'body', 'label'].flatMap((group) =>
  ['Large', 'Medium', 'Small'].map((size) => `${group}${size}`),
);
type Role = keyof typeof typescale;
const rows = ORDER.map((key) => {
  const base = typescale[key as Role];
  const emphasized = typescale[`${key}Emphasized` as Role];
  return { key, name: kebab(key), base, emphasized };
});
const tracking = (value: number) => (value === 0 ? '0' : value.toString().replace('-', '−'));
---

<Guide
  title="Typography"
  description="Fifteen type roles in five groups, display to label, each with an emphasized style. Components set type through the role tokens; the typeface is Google Sans Flex."
>
  <p>
    Each role is five custom properties, <code
      >--m3e-sys-typescale-&lt;role&gt;-{'{'}font, weight, size, line-height, tracking{'}'}</code
    >, and its emphasized style adds <code>-emphasized</code> after the role. Sizes are emitted
    in <code>rem</code> (1rem = 16sp), so they follow the reader's browser font size. The
    samples below are set with those tokens.
  </p>
  <CodeBlock
    lang="css"
    label="type role CSS"
    code={`.title {
  font-family: var(--m3e-sys-typescale-title-large-font);
  font-weight: var(--m3e-sys-typescale-title-large-weight);
  font-size: var(--m3e-sys-typescale-title-large-size);
  line-height: var(--m3e-sys-typescale-title-large-line-height);
  letter-spacing: var(--m3e-sys-typescale-title-large-tracking);
}`}
  />

  <h2 id="scale">The type scale</h2>
  <ul class="site-type-scale">
    {
      rows.map((row) => (
        <li class="site-type-scale__row">
          <span
            class="site-type-scale__sample"
            style={[
              `font-family: var(--m3e-sys-typescale-${row.name}-font)`,
              `font-weight: var(--m3e-sys-typescale-${row.name}-weight)`,
              `font-size: var(--m3e-sys-typescale-${row.name}-size)`,
              `line-height: var(--m3e-sys-typescale-${row.name}-line-height)`,
              `letter-spacing: var(--m3e-sys-typescale-${row.name}-tracking)`,
            ].join('; ')}
          >
            {row.name.replace('-', ' ')}
          </span>
          <span class="site-type-scale__meta">
            {row.base.size}/{row.base.lineHeight} sp · {row.base.weight}
          </span>
        </li>
      ))
    }
  </ul>

  <h2 id="values">Values</h2>
  <ScrollTable label="Type scale values">
    <table>
      <thead>
        <tr>
          <th scope="col">Role</th>
          <th scope="col">Size / line (sp)</th>
          <th scope="col">Weight</th>
          <th scope="col">Tracking (sp)</th>
          <th scope="col">Emphasized weight</th>
          <th scope="col">Emphasized tracking</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <th scope="row">
                <code>{row.name}</code>
              </th>
              <td>
                {row.base.size}/{row.base.lineHeight}
              </td>
              <td>{row.base.weight}</td>
              <td>{tracking(row.base.tracking)}</td>
              <td>{row.emphasized.weight}</td>
              <td>{tracking(row.emphasized.tracking)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </ScrollTable>
  <p>
    The emphasized styles keep the size and line height. Their weights are 500, or 700 for
    label and the smaller titles, and some tracking changes. Compose marks its emphasized block
    as provisional (<code>TypeScaleTokens.kt</code> L249), so it is re-checked at each source pin
    bump.
  </p>

  <h2 id="typeface">Typeface</h2>
  <p>
    Compose's tokens name the platform sans-serif; m3exp-web uses Google Sans Flex (DECISIONS
    D1), self-hosted and variable, with optical sizing left to <code>font-optical-sizing: auto</code>.
    It ships in three profiles of different axes and sizes; the
    <a href="/get-started/fonts-and-icons/">fonts and icons guide</a> covers them, the rounded
    profile and the licenses.
  </p>

  <h2 id="sources">Sources</h2>
  <ul>
    <li>
      Sizes, line heights, tracking and weights: <code>TypeScaleTokens.kt</code>,
      <code>TypographyTokens.kt</code> and <code>TypefaceTokens.kt</code> at the pinned commit,
      generated by m3e-codegen (FOUNDATIONS_SPEC §2).
    </li>
    <li>Typeface: DECISIONS D1, D11 and D15; google/fonts <code>ofl/googlesansflex</code>.</li>
  </ul>
</Guide>
