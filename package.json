{
  "name": "m3exp-web-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "pnpm lint:js && pnpm lint:css && pnpm format:check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen": "pnpm --filter \"@kyralabs/m3e-codegen...\" build && node packages/m3e-codegen/dist/cli.js generate",
    "codegen:check": "pnpm --filter \"@kyralabs/m3e-codegen...\" build && node packages/m3e-codegen/dist/cli.js generate --check",
    "codegen:fetch": "pnpm --filter \"@kyralabs/m3e-codegen...\" build && node packages/m3e-codegen/dist/cli.js fetch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "pnpm --filter @kyralabs/visual test",
    "size": "size-limit",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "changeset publish",
    "fonts": "pnpm --filter \"@kyralabs/m3e-codegen...\" build && node packages/m3e-codegen/dist/cli.js fonts",
    "fonts:check": "pnpm --filter \"@kyralabs/m3e-codegen...\" build && node packages/m3e-codegen/dist/cli.js fonts --check",
    "fonts:fetch": "pnpm --filter \"@kyralabs/m3e-codegen...\" build && node packages/m3e-codegen/dist/cli.js fonts:fetch",
    "icons": "pnpm --filter \"@kyralabs/m3e-codegen...\" build && node packages/m3e-codegen/dist/cli.js icons",
    "icons:check": "pnpm --filter \"@kyralabs/m3e-codegen...\" build && node packages/m3e-codegen/dist/cli.js icons --check",
    "icons:fetch": "pnpm --filter \"@kyralabs/m3e-codegen...\" build && node packages/m3e-codegen/dist/cli.js icons:fetch",
    "reference:motion": "node tools/jvm/kotlin.mjs --main androidx.compose.animation.core.SpringReferenceKt --out packages/m3e-motion/src/__fixtures__/spring-reference.json packages/m3e-codegen/vendor/androidx-animation-core tools/jvm/shims/UiUtil.kt tools/jvm/shims/Annotations.kt packages/m3e-motion/reference",
    "reference:shapes": "node tools/jvm/kotlin.mjs --main androidx.compose.material3.ShapesReferenceKt --out packages/m3e-shapes/src/__fixtures__/shapes-reference.json packages/m3e-codegen/vendor/androidx-graphics-shapes packages/m3e-codegen/vendor/androidx-material3-shapes packages/m3e-codegen/vendor/androidx-ui-graphics tools/jvm/shims packages/m3e-shapes/reference",
    "reference:carousel": "node tools/jvm/kotlin.mjs --main androidx.compose.material3.carousel.CarouselReferenceKt --out packages/m3e-motion/src/__fixtures__/carousel-reference.json packages/m3e-codegen/vendor/androidx-material3-carousel/Arrangement.kt packages/m3e-codegen/vendor/androidx-material3-carousel/KeylineList.kt packages/m3e-codegen/vendor/androidx-material3-carousel/KeylineSnapPosition.kt packages/m3e-codegen/vendor/androidx-material3-carousel/Keylines.kt packages/m3e-codegen/vendor/androidx-material3-carousel/Strategy.kt tools/jvm/shims/UiUtil.kt tools/jvm/shims/Collection.kt packages/m3e-motion/reference-carousel",
    "reference:loading-indicator": "node tools/jvm/kotlin.mjs --main androidx.compose.material3.LoadingIndicatorReferenceKt --out packages/m3e-shapes/src/__fixtures__/loading-indicator-reference.json packages/m3e-codegen/vendor/androidx-graphics-shapes packages/m3e-codegen/vendor/androidx-material3-shapes packages/m3e-codegen/vendor/androidx-ui-graphics tools/jvm/shims packages/m3e-shapes/reference/Material3Shims.kt packages/m3e-shapes/reference-loading-indicator"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "14.2.0",
    "@size-limit/preset-small-lib": "14.2.0",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "postcss-value-parser": "^4.2.0",
    "prettier": "3.9.10",
    "size-limit": "14.2.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
