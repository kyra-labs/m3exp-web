{
  "name": "@kyralabs/m3e-codegen",
  "version": "0.0.0",
  "description": "Build-time token generator from pinned AndroidX sources and material-color-utilities.",
  "license": "Apache-2.0",
  "author": "Kyra Labs",
  "homepage": "https://github.com/kyra-labs/m3exp-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyra-labs/m3exp-web.git",
    "directory": "packages/m3e-codegen"
  },
  "bugs": "https://github.com/kyra-labs/m3exp-web/issues",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "@kyralabs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@kyralabs/m3e-tokens": "workspace:^"
  }
}
