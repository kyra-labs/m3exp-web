{
  "name": "@kyralabs/m3e-css",
  "version": "1.0.0",
  "description": "Framework-free Material 3 Expressive component classes. No JavaScript.",
  "keywords": [
    "material-design",
    "material-3",
    "material-you",
    "m3-expressive",
    "design-system",
    "css",
    "components"
  ],
  "license": "Apache-2.0",
  "author": "Kyra Labs",
  "homepage": "https://github.com/kyra-labs/m3exp-web/tree/main/packages/m3e-css#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyra-labs/m3exp-web",
    "directory": "packages/m3e-css"
  },
  "bugs": "https://github.com/kyra-labs/m3exp-web/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./index.css": "./dist/index.css",
    "./*.css": "./dist/*.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../tools/build-css.js",
    "prepack": "node ../../tools/copy-legal.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@kyralabs/m3e-tokens": "workspace:^"
  }
}
