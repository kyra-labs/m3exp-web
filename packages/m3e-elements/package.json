{
  "name": "@kyralabs/m3e-elements",
  "version": "1.8.0",
  "description": "Zero-dependency Material 3 Expressive custom elements.",
  "keywords": [
    "material-design",
    "material-3",
    "material-you",
    "m3-expressive",
    "design-system",
    "web-components",
    "custom-elements"
  ],
  "license": "Apache-2.0",
  "author": "Kyra Labs",
  "homepage": "https://m3e.kyralabs.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyra-labs/m3exp-web",
    "directory": "packages/m3e-elements"
  },
  "bugs": "https://github.com/kyra-labs/m3exp-web/issues",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": true,
  "exports": {
    ".": {
      "@kyralabs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "@kyralabs/source": "./src/*/index.ts",
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.dts.json && rolldown -c rolldown.config.ts && tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node ../../tools/copy-legal.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@kyralabs/m3e-motion": "workspace:^",
    "@kyralabs/m3e-shapes": "workspace:^"
  }
}
