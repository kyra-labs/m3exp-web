{
  "name": "@kyralabs/m3e-react",
  "version": "0.0.0",
  "description": "Material 3 Expressive React components (React Aria + Motion). Client-side rendering only.",
  "keywords": [
    "material-design",
    "material-3",
    "material-you",
    "m3-expressive",
    "design-system",
    "react",
    "react-aria",
    "components"
  ],
  "license": "Apache-2.0",
  "author": "Kyra Labs",
  "homepage": "https://github.com/kyra-labs/m3exp-web/tree/main/packages/m3e-react#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyra-labs/m3exp-web",
    "directory": "packages/m3e-react"
  },
  "bugs": "https://github.com/kyra-labs/m3exp-web/issues",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kyralabs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node ../../tools/copy-legal.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@kyralabs/m3e-motion": "workspace:^",
    "@kyralabs/m3e-shapes": "workspace:^",
    "motion": "14.1.0",
    "react-aria": "3.53.1",
    "react-stately": "3.51.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@kyralabs/m3e-elements": "workspace:^",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
