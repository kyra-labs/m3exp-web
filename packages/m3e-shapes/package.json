{
  "name": "@kyralabs/m3e-shapes",
  "version": "1.0.1",
  "description": "TypeScript port of AndroidX graphics-shapes and MaterialShapes (internal-first).",
  "keywords": [
    "material-design",
    "material-3",
    "material-you",
    "m3-expressive",
    "design-system",
    "shapes",
    "morph",
    "graphics-shapes",
    "svg"
  ],
  "license": "Apache-2.0",
  "author": "Kyra Labs",
  "homepage": "https://github.com/kyra-labs/m3exp-web/tree/main/packages/m3e-shapes#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyra-labs/m3exp-web",
    "directory": "packages/m3e-shapes"
  },
  "bugs": "https://github.com/kyra-labs/m3exp-web/issues",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "@kyralabs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node ../../tools/copy-legal.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
