{
  "name": "@kyralabs/m3e-tokens",
  "version": "0.0.0",
  "description": "Generated Material 3 Expressive design tokens (CSS custom properties + JS objects) and self-hosted fonts.",
  "license": "Apache-2.0",
  "author": "Kyra Labs",
  "homepage": "https://github.com/kyra-labs/m3exp-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyra-labs/m3exp-web.git",
    "directory": "packages/m3e-tokens"
  },
  "bugs": "https://github.com/kyra-labs/m3exp-web/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@kyralabs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "@kyralabs/source": "./src/components.ts",
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js",
      "default": "./dist/components.js"
    },
    "./tokens.css": "./dist/generated/tokens.css",
    "./components/*.css": "./dist/generated/components/*.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node ../../tools/build-css.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node ../../tools/copy-legal.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
