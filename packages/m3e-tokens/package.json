{
  "name": "@kyralabs/m3e-tokens",
  "version": "0.0.0",
  "description": "Generated Material 3 Expressive design tokens (CSS custom properties + JS objects) and self-hosted fonts.",
  "license": "Apache-2.0",
  "author": "Kyra Labs",
  "homepage": "https://github.com/kyra-labs/m3exp-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyra-labs/m3exp-web.git",
    "directory": "packages/m3e-tokens"
  },
  "bugs": "https://github.com/kyra-labs/m3exp-web/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "bin": {
    "m3e-theme": "./dist/cli/theme.js"
  },
  "exports": {
    ".": {
      "@kyralabs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "@kyralabs/source": "./src/components.ts",
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js",
      "default": "./dist/components.js"
    },
    "./theme": {
      "@kyralabs/source": "./src/theme.ts",
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./theme-css": {
      "@kyralabs/source": "./src/theme-css.ts",
      "types": "./dist/theme-css.d.ts",
      "import": "./dist/theme-css.js",
      "default": "./dist/theme-css.js"
    },
    "./theme.css": "./dist/generated/theme.css",
    "./tokens.css": "./dist/generated/tokens.css",
    "./components/*.css": "./dist/generated/components/*.css",
    "./fonts.css": "./fonts/fonts.css",
    "./fonts-full.css": "./fonts/fonts-full.css",
    "./material-symbols.css": "./fonts/material-symbols.css",
    "./material-symbols-*.css": "./fonts/material-symbols-*.css",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node ../../tools/build-css.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node ../../tools/copy-legal.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@material/material-color-utilities": "0.4.0"
  }
}
