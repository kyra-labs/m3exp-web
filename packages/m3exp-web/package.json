{
  "name": "@kyralabs/m3exp-web",
  "version": "1.8.0",
  "description": "Material 3 Expressive for the web: umbrella package re-exporting tokens, css, elements and react.",
  "keywords": [
    "material-design",
    "material-3",
    "material-you",
    "m3-expressive",
    "design-system",
    "web-components",
    "custom-elements",
    "react",
    "css",
    "design-tokens"
  ],
  "license": "Apache-2.0",
  "author": "Kyra Labs",
  "homepage": "https://github.com/kyra-labs/m3exp-web/tree/main/packages/m3exp-web#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyra-labs/m3exp-web",
    "directory": "packages/m3exp-web"
  },
  "bugs": "https://github.com/kyra-labs/m3exp-web/issues",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css",
    "./dist/elements.js",
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "@kyralabs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "@kyralabs/source": "./src/tokens.ts",
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "default": "./dist/tokens.js"
    },
    "./elements": {
      "@kyralabs/source": "./src/elements.ts",
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js",
      "default": "./dist/elements.js"
    },
    "./react": {
      "@kyralabs/source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./theme": {
      "@kyralabs/source": "./src/theme.ts",
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./css/index.css": "./dist/css/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node ../../tools/build-css.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node ../../tools/copy-legal.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@kyralabs/m3e-tokens": "workspace:^",
    "@kyralabs/m3e-css": "workspace:^",
    "@kyralabs/m3e-elements": "workspace:^",
    "@kyralabs/m3e-react": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
